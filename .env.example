# API do Claude (gera o conteúdo)
ANTHROPIC_API_KEY=
# Modelo usado para gerar o texto (opcional — default abaixo)
ANTHROPIC_MODEL=claude-opus-4-8

# Meta / Facebook
META_ACCESS_TOKEN=
META_PAGE_ID=
# META_IG_USER_ID fica reservado para quando o Instagram for religado ao
# pipeline (exige um passo de geração/hospedagem de imagem — ver
# src/postagem_automatica/infrastructure/publishers/instagram_publisher.py)
META_IG_USER_ID=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DESTINOS=whatsapp:+5511999999999

# Agendamento (horários de postagem, separados por vírgula, formato HH:MM)
HORARIOS_POSTAGEM=08:00,18:00

# Fuso horário em que HORARIOS_POSTAGEM é interpretado (IANA tz — importante:
# sem isso, um servidor rodando em UTC posta nos horários errados)
TZ_POSTAGEM=America/Sao_Paulo

# Temas para a IA gerar conteúdo (separados por ;)
TEMAS=reflexão do dia;versículo com aplicação prática;mensagem de encorajamento

# Caminho do banco SQLite de histórico (opcional — default abaixo)
DB_PATH=data/posts.db

# Nível de log: DEBUG, INFO, WARNING, ERROR (opcional — default INFO)
LOG_LEVEL=INFO
