# ── Backend de IA ─────────────────────────────────────────────────────────────
# Copie apenas um dos blocos abaixo para o seu .env

# Ollama inteiramente local (sem custo de API)
AI_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# OLLAMA_NO_CLOUD=1              # rejeita modelos :cloud/-cloud explicitamente
# OLLAMA_CONTEXT_LENGTH=4096     # ponto de partida seguro para GPUs <8 GB VRAM

# DeepSeek em nuvem
# AI_BACKEND=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI em nuvem
# AI_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4

# Comportamento antigo: DeepSeek com prioridade; OpenAI como fallback
# AI_BACKEND=auto

# ── Meta / Instagram / Facebook ───────────────────────────────────────────────
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DESTINOS=whatsapp:+5511999999999

# ── Agendamento ───────────────────────────────────────────────────────────────
# Horários de postagem, separados por vírgula, formato HH:MM
HORARIOS_POSTAGEM=08:00,18:00

# ── Temas para geração de conteúdo ───────────────────────────────────────────
# Separados por ;
TEMAS=reflexão do dia;versículo com aplicação prática;mensagem de encorajamento
