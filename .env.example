# Backend de IA: "claude" (padrão) ou "ollama" (local, sem custo de API)
AI_BACKEND=claude

# API do Claude — necessário apenas quando AI_BACKEND=claude
ANTHROPIC_API_KEY=

# Ollama local — necessário apenas quando AI_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# Meta / Instagram / Facebook
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DESTINOS=whatsapp:+5511999999999

# Agendamento (horários de postagem, separados por vírgula, formato HH:MM)
HORARIOS_POSTAGEM=08:00,18:00

# Temas para a IA gerar conteúdo (separados por ;)
TEMAS=reflexão do dia;versículo com aplicação prática;mensagem de encorajamento
