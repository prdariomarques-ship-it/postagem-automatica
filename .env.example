# ── Backend de IA ─────────────────────────────────────────────────────────────
# Copie apenas um dos blocos abaixo para o seu .env
# Nunca versione o .env com valores de produção.

# Ollama inteiramente local (sem custo de API)
AI_BACKEND=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Variáveis de cliente Ollama (opcionais):
# OLLAMA_NO_CLOUD=1              # rejeita modelos :cloud/-cloud e bloqueia recursos cloud
# OLLAMA_CONTEXT_LENGTH=4096     # tokens de contexto por requisição (seguro para GPU <8 GB VRAM)
# OLLAMA_KEEP_ALIVE=0            # libera VRAM imediatamente após resposta ("30s"/"2m" para equilíbrio)

# Variáveis de SERVIDOR Ollama — defina no processo ollama/systemd, não aqui:
# (Listadas apenas como referência; use scripts/systemd/ollama-override.conf.example)
# OLLAMA_NUM_PARALLEL=1          # requisições paralelas por modelo
# OLLAMA_MAX_LOADED_MODELS=1     # modelos simultâneos na VRAM
# OLLAMA_HOST=127.0.0.1:11434    # onde o servidor escuta (sem scheme para systemd)

# DeepSeek em nuvem
# AI_BACKEND=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI em nuvem
# AI_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4

# Comportamento antigo: DeepSeek com prioridade; OpenAI como fallback
# AI_BACKEND=auto
# Atenção: não use "auto" em perfil local-only — pode selecionar provedor cloud se houver chave.

# ── Meta / Instagram / Facebook ───────────────────────────────────────────────
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DESTINOS=whatsapp:+5511999999999

# ── Agendamento ───────────────────────────────────────────────────────────────
HORARIOS_POSTAGEM=08:00,18:00

# ── Temas para geração de conteúdo ───────────────────────────────────────────
TEMAS=reflexão do dia;versículo com aplicação prática;mensagem de encorajamento
